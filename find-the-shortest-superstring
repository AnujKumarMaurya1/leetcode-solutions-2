class Solution:
    def shortestSuperstring(self, words: List[str]) -> str:
        n = len(words)
        
        # Calculate the overlap between two words
        def calculate_overlap(word1, word2):
            max_overlap = 0
            for i in range(1, min(len(word1), len(word2)) + 1):
                if word1.endswith(word2[:i]):
                    max_overlap = i
            return max_overlap
        
        # Calculate overlap for all pairs of words
        overlap = [[calculate_overlap(words[i], words[j]) for j in range(n)] for i in range(n)]
        
        # Initialize DP table
        dp = [[''] * n for _ in range(1 << n)]
        
        # Fill DP table
        for mask in range(1, 1 << n):
            for bit in range(n):
                if mask & (1 << bit):
                    prev_mask = mask ^ (1 << bit)
                    if prev_mask == 0:
                        dp[mask][bit] = words[bit]
                    else:
                        for prev_bit in range(n):
                            if prev_mask & (1 << prev_bit):
                                current = dp[prev_mask][prev_bit] + words[bit][overlap[prev_bit][bit]:]
                                if dp[mask][bit] == '' or len(current) < len(dp[mask][bit]):
                                    dp[mask][bit] = current
        
        # Find the shortest superstring
        full_mask = (1 << n) - 1
        return min(dp[full_mask], key=len)
