class Solution(object):
    def maximumSaleItems(self, items, budget):
      
        n = len(items)

        # counter[f] := number of items with factor f
        counter = [0] * (n + 1)

        # 1. build counter
        for f, _ in items:
            counter[f] += 1

        # multiples[f] := number of items whose factor is a multiple of f
        multiples = [0] * (n + 1)

        # 2. count multiples of each factor
        for f in range(1, n + 1):
            # pass 
            if counter[f] == 0:
                continue

            # iterate with the pace of f
            for g in range(f, n + 1, f):
                multiples[f] += counter[g]

        # free_bonus[i] := number of items j (j != i) whose factor is divisible by factor_i

        # 3. subtract 1 to exclude item i itself
        free_bonus = [multiples[f] - 1 for f, _ in items]

        # 4. extracct cheapest price; every copy worth 1 is bought at this price
        min_price = min(p for _, p in items)

        # 5. sort items by price increasing order
        order = sorted(range(n), key=lambda i: items[i][1])

        res = 0

        # 6. buy copies worth 2, cheapest first, while they beat two copies at min_price
        for i in order:
            _, price = items[i]

            # from here on every price is > 2 * min_price, so no more copies worth 2 pay off
            if price > 2 * min_price:
                break

            # buy as many copies worth 2 as the budget allows
            x = min(free_bonus[i], budget // price)
            res += 2 * x

            # update 
            budget -= x * price

        # 7. spend what is left on the cheapest item (each copy worth 1)
        res += budget // min_price

        return res
