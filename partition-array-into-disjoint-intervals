class Solution:
    def partitionDisjoint(self, nums: List[int]) -> int: 
        left_max = nums[0]
        current_max = nums[0]
        partition_idx = 0
        n = len(nums)
        i = 0
        while i < n:
            if nums[i] < left_max:
                left_max = current_max
                partition_idx = i
            else:
                current_max = max(nums[i], current_max)
            i += 1
        return partition_idx + 1
